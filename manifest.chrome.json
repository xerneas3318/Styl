{
  "manifest_version": 3,
  "name": "Styl",
  "version": "2.0.0",
  "description": "Personal operating system for your browser",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "dist/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
