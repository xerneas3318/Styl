{
  "manifest_version": 2,
  "name": "Styl",
  "version": "1.0.0",
  "description": "A beautiful new tab with Pomodoro focus timer — by xerneas",
  "permissions": [
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": ["shared/sound.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Styl"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
