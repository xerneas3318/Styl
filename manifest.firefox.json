{
  "manifest_version": 3,
  "name": "Styl",
  "version": "2.0.0",
  "description": "Personal operating system for your browser",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["dist/background.js"]
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "styl@xerneas",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [],
        "optional": []
      }
    }
  }
}
